<%-include('../cabecalho.ejs')%>
    <h1>campeonatos</h1>
    <div>
        <form action="
        " method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o nome">
         <button type="submit">Pesquisar</button>
    </form>
    </div>
    <a href="/campeonato/add">+ campeonato</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>País</td>
            <td>Ações</td>
        </tr>
      
        <%for (const {id, nome, pais} of campeonatos) {%>
        <tr>
            <td><%=nome%></td>
            <td><%=pais%></td>
            <td><a href="/campeonato/edt/<%=id%>">Editar</a>
            <a href="/campeonato/del/<%=id%>">Excluir</a></td>
        </tr>
        <%}%>
    </table>
