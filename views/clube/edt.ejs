<%-include('../cabecalho.ejs')%>
<h1>Editar clube</h1>
<div>
<a href="/clube/lst">Listar</a>
</div>
<div>
    <form  method="post" enctype="multipart/form-data">

        <input type="hidden" name="id" 
        value="<%=Clube.id%>"><br>
        <label>Nome:</label>
        <input type="text" name="nome" 
        value="<%=Clube.nome%>"><br>
        <label>Ano de fundação:</label>
        <input type="text" name="anoFundacao"
        value="<%=Clube.anoFundacao%>"
        ><br>
        <div class="mb-3">
        <label for="campeonato" class="form-label">Campeonatos</label>
            <select name="campeonato" id="campeonato" class="form-control">
                <option value="">selecione</option>
                <% Campeonatos.forEach(function(campeonato){ %>
                    <option value="<%=campeonato.id%>"
                        <%= (Clube.campeonato && campeonato.id.toString() === Clube.campeonato.toString())
                            ? 'selected'
                            : '' %>
                    >
                        <%=campeonato.nome%>
                    </option>
                <% }) %>
            </select>
        </div>
        <label>Número de Títulos:</label>
        <input type="number" name="nroTitulos"
        value="<%=Clube.nroTitulos%>"
        ><br>
        <label>Escudo: <img src="<%=Clube.escudo%>" width="150" height="150"></label>
        <input type="file" name="escudo"
        value="<%=Clube.escudo%>"
        ><br>
        <button type="submit">Cadastrar</button>
    </form>
</div>

<%-include('../rodape.ejs')%>