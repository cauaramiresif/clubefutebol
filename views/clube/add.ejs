<%-include('../cabecalho.ejs')%>
    <h1>Adicionar clube</h1>
    <div>
        <a href="/clube/lst">Listar</a>
    </div>
    <div>
        <form method="post" enctype="multipart/form-data">
            <label>Nome:</label>
            <input type="text" name="nome"><br>
            <label>Ano de fundação:</label>
            <input type="text" name="anoFundacao"><br>
            <div class="mb-3">
                <label for="campeonato" class="form-label">Campeonatos</label>
                <select name="campeonato" id="campeonato" class="form-control">
                <option value="">selecione</option>
                <%Campeonatos.forEach(function(campeonato){%>
                <option value='<%=campeonato.id%>'>
                <%=campeonato.nome%>
                </option>
                <%})%>
                </select>
            </div>
            <label>Número de títulos:</label>
            <input type="number" name="nroTitulos"><br>
            <label>Escudo:</label>
            <input type="file" name="escudo"><br>
            <button type="submit">Cadastrar</button>

        </form>
    </div>

<%-include('../rodape.ejs')%>