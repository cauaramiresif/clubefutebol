<%-include('../cabecalho.ejs')%>
    <h1>clubes</h1>
    <div>
        <form action="
        " method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o nome">
         <button type="submit">Pesquisar</button>
    </form>
    </div>
    <a href="/clube/add">+ clube</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>Ano de Fundação</td>
            <td>Campeonatos</td>
            <td>Número de títulos</td>
            <td>Escudo</td>
            <td>Ações</td>
        </tr>
      
        <%for (const {id, nome, anoFundacao, campeonato, nroTitulos, escudo} of Clubes) {%>
        <tr>
            <td><%=nome%></td>
            <td><%=anoFundacao%></td>
            <td><%=campeonato%></td>
            <td><%=nroTitulos%></td>
            <td><img src="<%=escudo%>" width="150" height="150"></td>
            <td><a href="/clube/edt/<%=id%>">Editar</a>
            <a href="/clube/del/<%=id%>">Excluir</a></td>
        </tr>
        <%}%>
    </table>
 <%-include('../rodape.ejs')%>