<%
  // Cartão de clube - usado na home e na listagem.
  var campeonatoNome = clube.campeonatos && clube.campeonatos.nome ? clube.campeonatos.nome : 'Sem campeonato vinculado';
  var iniciais = (clube.nome || '?').trim().split(/\s+/).map(function (p) { return p.charAt(0); }).join('').slice(0, 3).toUpperCase();
  var acoes = (typeof mostrarAcoes === 'undefined') || mostrarAcoes;
%>
<article class="card">
  <button type="button" class="card__favorito"
          data-favorito="<%= clube.id %>" data-nome="<%= clube.nome %>"
          aria-pressed="false"
          aria-label="Adicionar <%= clube.nome %> aos clubes favoritos">
    <span class="card__favorito__icone" aria-hidden="true">&#9825;</span>
  </button>
  <div class="card__midia">
    <% if (clube.escudo) { %>
      <img src="<%= clube.escudo %>" width="112" height="112"
           alt="Escudo do clube <%= clube.nome %>">
    <% } else { %>
      <span class="card__inicial" role="img" aria-label="Sem escudo cadastrado para <%= clube.nome %>"><%= iniciais %></span>
    <% } %>
  </div>
  <div class="card__corpo">
    <h3 class="card__titulo"><%= clube.nome %></h3>
    <ul class="card__lista">
      <li><strong>Fundação:</strong> <%= clube.anoFundacao %></li>
      <li><strong>Campeonato:</strong> <%= campeonatoNome %></li>
      <li><strong>Títulos:</strong> <%= clube.nroTitulos %></li>
    </ul>
  </div>
</article>
