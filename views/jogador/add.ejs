<%-include('../cabecalho.ejs')%>

  <h1 class="titulo-pagina">Cadastrar jogador</h1>
  <p class="subtitulo-pagina">Informe os dados do atleta e envie a foto de identificação.</p>

  <p class="bloco-acoes">
    <a class="btn btn--voltar" href="/jogador/lst">Voltar para a lista de jogadores</a>
  </p>

  <form class="formulario" method="post" enctype="multipart/form-data">
    <fieldset>
      <legend>Dados do jogador</legend>

      <div class="campo">
        <label for="nome">Nome completo</label>
        <input type="text" id="nome" name="nome" required autocomplete="off">
      </div>

      <div class="campo">
        <label for="camisa">Número da camisa</label>
        <input type="number" id="camisa" name="camisa" min="1" max="99" required>
      </div>

      <div class="campo">
        <label for="posicao">Posição preferida</label>
        <input type="text" id="posicao" name="posicao" required list="posicoes" placeholder="Goleiro, zagueiro, volante...">
        <datalist id="posicoes">
          <option value="Goleiro"></option>
          <option value="Zagueiro"></option>
          <option value="Lateral-direito"></option>
          <option value="Lateral-esquerdo"></option>
          <option value="Volante"></option>
          <option value="Meia-armador"></option>
          <option value="Ponta-direita"></option>
          <option value="Ponta-esquerda"></option>
          <option value="Centroavante"></option>
        </datalist>
      </div>

      <div class="campo">
        <label for="localNascimento">Local de nascimento</label>
        <input type="text" id="localNascimento" name="localNascimento" required placeholder="Cidade e estado">
      </div>

      <div class="campo">
        <label for="clube">Clube atual</label>
        <select id="clube" name="clube">
          <option value="">Selecione (opcional)</option>
          <% Clubes.forEach(function (clube) { %>
            <option value="<%= clube.id %>"><%= clube.nome %></option>
          <% }) %>
        </select>
      </div>
    </fieldset>

    <fieldset>
      <legend>Imagem do jogador</legend>
      <div class="campo">
        <label for="foto">Arquivo da foto</label>
        <input type="file" id="foto" name="foto" accept="image/*" required>
        <span class="dica-campo">A foto recebe como descrição alternativa o nome informado acima.</span>
      </div>
    </fieldset>

    <div class="formulario-acoes">
      <button type="submit" class="btn btn--acento">Cadastrar</button>
      <a class="btn btn--voltar" href="/jogador/lst">Cancelar</a>
    </div>
  </form>

<%-include('../rodape.ejs')%>
