<%-include('../cabecalho.ejs')%>
<h1>Editar Jogador</h1>
<div>
<a href="/jogador/lst">Listar</a>
</div>
<div>
    <form method="post" enctype="multipart/form-data">

        <input type="hidden" name="id" value="<%=Jogador.id%>"><br>
        <label>Nome:</label>
        <input type="text" name="nome"
        value="<%=Jogador.nome%>"><br>
        <label>Camisa:</label>
        <input type="number" name="camisa"
        value="<%=Jogador.camisa%>"><br>
        <label>Local de Nascimento:</label>
        <input type="text" name="localNascimento"
        value="<%=Jogador.localNascimento%>"><br>
        <div class="mb-3">
        <label for="clube" class="form-label">Clube</label>
            <select name="clube" id="clube" class="form-control">
                <option value="">selecione</option>
                <% Clubes.forEach(function(clube){ %>
                    <option value="<%=clube.id%>"
                        <%= (Jogador.clube && clube.id.toString() === Jogador.clube.toString())
                            ? 'selected'
                            : '' %>
                    >
                        <%=clube.nome%>
                    </option>
                <% }) %>
            </select>
        </div>
        <label>Posição Preferida:</label>
        <input type="text" name="posicao"
        value="<%=Jogador.posicao%>"><br>
        <label>Foto:</label>
        <input type="file" name="foto"><br>
        <button type="submit">Cadastrar</button>
    </form>
</div>

<%-include('../rodape.ejs')%>