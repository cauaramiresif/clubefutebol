<%-include('../cabecalho.ejs')%>
    <h1>jogadores</h1>
    <div>
        <form action="
        " method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o nome">
         <button type="submit">Pesquisar</button>
    </form>
    </div>
    <a href="/jogador/add">+ jogador</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>Camisa</td>
            <td>Local de Nascimento</td>
            <td>Clube</td>
            <td>Posicao</td>
            <td>Foto</td>
            <td>Ações</td>
        </tr>
      
        <%for (const {id, nome, camisa, localNascimento, clube, posicao, foto} of Jogadores) {%>
        <tr>
            <td><%=nome%></td>
            <td><%=camisa%></td>
            <td><%=localNascimento%></td>
            <td><%=clube%></td>
            <td><%=posicao%></td>
            <td><img src="<%=foto%>" width="150" height="150"></td>
            <td><a href="/jogador/edt/<%=id%>">Editar</a>
            <a href="/jogador/del/<%=id%>">Excluir</a></td>
        </tr>
        <%}%>
    </table>
 <%-include('../rodape.ejs')%>