<%-include('../cabecalho.ejs')%>
<h1>Editar tecnico</h1>
<div>
<a href="/tecnico/lst">Listar</a>
</div>
<div>
    <form  method="post" enctype="multipart/form-data">
       
        <input type="hidden" name="id" 
        value="<%=Tecnico.id%>"><br>
        <label>Nome:</label>
        <input type="text" name="nome" 
        value="<%=Tecnico.nome%>"><br>
        <label>Local de Nascimento:</label>
        <input type="text" name="localNascimento"
        value="<%=Tecnico.localNascimento%>"
        ><br>
        <label>Clube:</label>
        <input type="text" name="clube"
        value="<%=Tecnico.clube%>"
        ><br>
        <label>Foto:</label>
        <input type="file" name="foto"
        value="<%=Tecnico.foto%>"
        ><br>
        <button type="submit">Cadastrar</button>
        
    </form>
</div>

<%-include('../rodape.ejs')%>